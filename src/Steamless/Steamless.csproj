<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>{10AC8FDE-09D9-47B4-AA89-BADC40EECAAB}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Steamless</RootNamespace>
    <AssemblyName>Steamless</AssemblyName>
    <ApplicationIcon>Assets\steam.ico</ApplicationIcon>
    <AssemblyVersion>5.0.0</AssemblyVersion>
    <FileVersion>5.0.0</FileVersion>
    <AssemblyTitle>Steamless-KR</AssemblyTitle>
    <Product>Steamless-KR</Product>
    <Description>Removes the SteamStub DRM protection from Steam applications.</Description>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <!-- Windows-only target: Avalonia.Desktop would also pull in the X11, macOS
         and FreeDesktop backends, which this app never loads. -->
    <PackageReference Include="Avalonia.Win32" Version="12.1.2" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ShadUI" Version="0.2.4" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\steam.ico" />
  </ItemGroup>

  <!--
    Crossgen of the app assembly produced a runtime fail-fast with the lazily built main
    view, so the app stays IL while its dependencies are precompiled.
  -->
  <ItemGroup>
    <PublishReadyToRunExclude Include="Steamless.dll" />
    <!-- Themes and UI shells are mostly resources. Precompiling their code bloats the
         archive without helping the first window. -->
    <PublishReadyToRunExclude Include="Avalonia.Themes.Fluent.dll;Avalonia.Themes.Simple.dll;ShadUI.dll;Avalonia.Controls.DataGrid.dll;Avalonia.Controls.ColorPicker.dll;Avalonia.Dialogs.dll;Avalonia.Vulkan.dll;Avalonia.OpenGL.dll;SkiaSharp.dll;HarfBuzzSharp.dll;CommunityToolkit.Mvvm.dll;Avalonia.Win32.Automation.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Steamless.API\Steamless.API.csproj" />
    <ProjectReference Include="@(UnpackerProject)" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!--
    Binaries the app never loads. ANGLE is dead because the renderer is software
    only; DesignerSupport and Remote.Protocol serve the XAML previewer and the
    dev tools. Avalonia.Metal stays: without it the window paints black.

    Composite ReadyToRun bakes references to DesignerSupport into the image, so
    those files have to stay for that publish.
  -->
  <Target Name="DropUnusedAvaloniaBinaries" AfterTargets="Publish"
          Condition="'$(PublishDir)' != '' and '$(PublishReadyToRunComposite)' != 'true'">
    <ItemGroup>
      <_UnusedAvaloniaBinary Include="$(PublishDir)av_libglesv2.dll" />
      <_UnusedAvaloniaBinary Include="$(PublishDir)Avalonia.DesignerSupport.dll" />
      <_UnusedAvaloniaBinary Include="$(PublishDir)Avalonia.Remote.Protocol.dll" />
    </ItemGroup>
    <Delete Files="@(_UnusedAvaloniaBinary)" />
  </Target>
</Project>

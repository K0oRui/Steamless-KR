<shadui:Window x:Class="Steamless.View.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
        xmlns:controls="using:Steamless.Controls"
        xmlns:converters="using:Steamless.Converters"
        xmlns:presentation="using:Steamless.Presentation"
        xmlns:view="using:Steamless.View"
        xmlns:vm="using:Steamless.ViewModel"
        x:CompileBindings="True"
        x:DataType="vm:MainWindowViewModel"
        Title="Steamless-KR"
        Width="620" Height="720" MinWidth="560" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        BorderThickness="0"
        Opacity="0"
        UseLayoutRounding="True"
        RootCornerRadius="8"
        IsTitleBarVisible="False"
        TitleBarAnimationEnabled="False"
        Icon="avares://Steamless/Assets/steam.ico">

    <shadui:Window.Resources>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
    </shadui:Window.Resources>

    <Border x:Name="ContentRoot" CornerRadius="8" BorderBrush="{StaticResource Border1Brush}" BorderThickness="1"
            PointerPressed="ContentRoot_PointerPressed">
        <Border.Background>
            <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#3A266E" Offset="0" />
                <GradientStop Color="#2A1B4F" Offset="0.12" />
                <GradientStop Color="#1E1E1E" Offset="0.25" />
                <GradientStop Color="#1E1E1E" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid RowDefinitions="44,*">
            <Grid x:Name="TitleBar" Grid.Row="0" ColumnDefinitions="Auto,*,Auto"
                  Background="Transparent"
                  PointerPressed="TitleBar_PointerPressed">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0" VerticalAlignment="Center">
                    <controls:SteamLogo Width="24" Height="24" />
                    <TextBlock Text="Steamless-KR" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Text1Brush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                    <Button Classes="caption" Command="{Binding ToggleAboutViewCommand}"
                            ToolTip.Tip="About Steamless-KR" AutomationProperties.Name="About Steamless-KR">
                        <LucideIcon Kind="Info" Size="14" StrokeWidth="1.8"
                                    Foreground="{Binding $parent[Button].Foreground}" />
                    </Button>

                    <Border Width="1" Height="16" Margin="4,0" Background="{StaticResource Border2Brush}" />

                    <Button Classes="caption" Click="Minimize_Click"
                            ToolTip.Tip="Minimize" AutomationProperties.Name="Minimize">
                        <LucideIcon Kind="Minus" Size="12" StrokeWidth="2"
                                    Foreground="{Binding $parent[Button].Foreground}" />
                    </Button>

                    <Button Classes="caption" Click="Maximize_Click"
                            ToolTip.Tip="Maximize" AutomationProperties.Name="Maximize">
                        <Panel>
                            <LucideIcon x:Name="MaximizeIcon" Kind="Square" Size="12" StrokeWidth="2"
                                        Foreground="{Binding $parent[Button].Foreground}" />
                            <!-- Mirrored copy: Windows draws restore with the back window at the top-right. -->
                            <LucideIcon x:Name="RestoreIcon" Kind="Copy" Size="12" StrokeWidth="2" IsVisible="False"
                                        Foreground="{Binding $parent[Button].Foreground}">
                                <LucideIcon.RenderTransform>
                                    <ScaleTransform ScaleX="-1" />
                                </LucideIcon.RenderTransform>
                            </LucideIcon>
                        </Panel>
                    </Button>

                    <Button Classes="caption close" Click="Close_Click"
                            ToolTip.Tip="Close" AutomationProperties.Name="Close">
                        <LucideIcon Kind="X" Size="12" StrokeWidth="2"
                                    Foreground="{Binding $parent[Button].Foreground}" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" x:Name="ViewGrid">
                <view:SplashView x:Name="SplashHost"
                                 Opacity="{Binding ShowSplashView, Converter={StaticResource BoolToOpacityConverter}}"
                                 IsHitTestVisible="{Binding ShowSplashView}" IsEnabled="{Binding ShowSplashView}">
                    <view:SplashView.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="{x:Static presentation:ShellMotion.Slow}" />
                        </Transitions>
                    </view:SplashView.Transitions>
                </view:SplashView>
                <ContentControl x:Name="MainHost"
                                Opacity="{Binding ShowMainView, Converter={StaticResource BoolToOpacityConverter}}"
                                IsHitTestVisible="{Binding ShowMainView}" IsEnabled="{Binding ShowMainView}">
                    <ContentControl.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="{x:Static presentation:ShellMotion.Slow}" />
                        </Transitions>
                    </ContentControl.Transitions>
                </ContentControl>
                <ContentControl x:Name="AboutHost"
                                Opacity="{Binding ShowAboutViewPanel, Converter={StaticResource BoolToOpacityConverter}}"
                                IsHitTestVisible="{Binding ShowAboutViewPanel}" IsEnabled="{Binding ShowAboutViewPanel}">
                    <ContentControl.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="{x:Static presentation:ShellMotion.Slow}" />
                        </Transitions>
                    </ContentControl.Transitions>
                </ContentControl>
            </Grid>
        </Grid>
    </Border>
</shadui:Window>

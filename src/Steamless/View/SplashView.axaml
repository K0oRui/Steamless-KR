<UserControl x:Class="Steamless.View.SplashView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Steamless.Controls"
             xmlns:vm="using:Steamless.ViewModel"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">

    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0">
            <Ellipse Width="380" Height="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="0,-90,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#226C5CE7" Offset="0" />
                        <GradientStop Color="#006C5CE7" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-48,0,0">
                <controls:SteamLogo Width="96" Height="96" HorizontalAlignment="Center" />

                <TextBlock Text="Steamless-KR" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,16,0,0">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                            <GradientStop Color="#E1E1E1" Offset="0" />
                            <GradientStop Color="#D7D7D7" Offset="1" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

                <TextBlock Text="SteamStub DRM remover" FontSize="12" Foreground="{StaticResource Text2Brush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />

                <Grid Width="220" Margin="0,30,0,0">
                    <ProgressBar Height="3" MinHeight="0" Foreground="{StaticResource AccentBrush}" Background="{StaticResource Surface2Brush}"
                                 IsIndeterminate="True" />
                </Grid>

                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Text2Brush}" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding SteamlessVersion, FallbackValue='0.0.0', StringFormat='{}v{0}'}"
                   Foreground="{StaticResource Text2Brush}" FontSize="10" FontFamily="Cascadia Mono, Consolas"
                   HorizontalAlignment="Right" Margin="0,0,16,12" />
    </Grid>
</UserControl>

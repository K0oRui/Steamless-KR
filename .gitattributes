# Auto-detect text files, store LF and check out LF everywhere. Without eol=lf
# a Windows checkout with core.autocrlf=true would hand back CRLF and every
# formatter run would disagree with CI.
* text=auto eol=lf

# Source code
*.cs text diff=csharp
*.xaml text
*.csproj text
*.sln text
*.xml text
*.json text
*.props text
*.targets text
*.yml text
*.yaml text
*.md text
*.ps1 text
*.sh text

# Binary files
*.exe binary
*.dll binary
*.pdb binary
*.png binary
*.ico binary

# Git
.gitattributes text
.gitignore text
